      "serverUrl": "https://live-mcp.example.invalid/mcp",
      "command": "node live-server.js",
      "env": {
        "MCP_TOKEN": "redacted-placeholder"
      },
      "toolName": "quote_stream",
      "runtimeExecutionAllowed": true,
      "networkAccess": true,
      "mcpInvocation": true,
      "paymentAccess": true
    }
  },
  "x402": {

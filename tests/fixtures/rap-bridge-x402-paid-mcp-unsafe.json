    "PaymentSignature": {
      "selectedRail": "base",
      "payer": "agent:unsafe-demo",
      "rawSignature": "redacted-placeholder",
      "walletPrivateKey": "redacted-placeholder"
    },
    "PaymentResponse": {
      "success": true,
      "transactionHash": "0xunsafe",
      "network": "base-mainnet",
      "payer": "agent:unsafe-demo"
    },
    "facilitator": {
      "id": "live-facilitator",
      "endpoint": "https://facilitator.example.invalid/settle"
    }
  },
  "authority": {
    "mandateId": "mandate:unsafe",
    "spender": "agent:unsafe-demo",
    "scope": "*",
    "maxAmount": null,
    "asset": "USDC",
    "rails": ["base"],
    "expiresAt": null,
    "revocationRef": null,
    "auditRef": null
  },
  "receipts": {
    "paymentRef": "0xunsafe",
    "serviceResultStatus": "unknown",
    "requiredEvalGateStatus": "unknown",

        "devnet/mainnet confusion scenario"
      ],
      "mustProve": [
        "cluster label",
        "signature",
        "confirmation",
        "mint/program allowlist",
        "payer/payee/amount"
      ],
      "readyWhen": "devnet and mainnet receipts are impossible to confuse"
    },
    "replayResistance": {
      "evidence": [
        "stale mandate fixture",
        "replayed request fixture"
      ],
      "mustProve": [
        "nonce uniqueness",
        "mandate id binding",
        "request hash binding",
        "expiry enforcement"
      ],
      "readyWhen": "stale or reused nonce/request pairs cannot spend or emit receipts"
    },
    "rollbackKillSwitch": {
      "evidence": [
        "rollback scenario",
        "kill-switch owner and state"
      ],
      "mustProve": [
        "operator pause",
        "mandate revocation",
        "per-agent suspension",
        "receipt review marking"
      ],
      "readyWhen": "future spend can be stopped without mutating historical evidence"
    },
    "spendLimits": {
      "evidence": [
        "over-budget fail-closed fixture",
        "cap pre-sign and pre-receipt checks"
      ],
      "mustProve": [
        "per-intent cap",
        "per-tester cap",
        "daily cap",
        "global cohort cap"
      ],
      "readyWhen": "limits are enforced before signing and before receipt completion"
    }
  },
